<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ranks the dock's apps by use. Granted by the Shizuku helper, which may set app ops. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Head tracking reads the glasses' motion sensor over USB -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <queries>
        <!-- Apps for the home screens' dock and app drawer -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Setup checks whether Shizuku is installed -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XRdroid">

        <!-- The phone screen and launcher entry: Remote and Settings tabs -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.xrdroid.phone">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Makes and changes the wearer's own screen layouts -->
        <activity
            android:name=".LayoutEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- The view on the glasses. Exported so it can be launched on the glasses display over adb. Its
             own single-instance task, so relaunching never stacks a second copy. -->
        <activity
            android:name=".GlassesActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.xrdroid.glasses"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Home screen and app drawer shown inside each spatial screen; one task per screen -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.XRdroid.Home" />

        <!-- Receives the Shizuku binder, which runs the helper as the shell user -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>

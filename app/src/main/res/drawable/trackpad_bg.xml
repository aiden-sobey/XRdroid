<?xml version="1.0" encoding="utf-8"?>
<!-- Trackpad surface: a softly lit panel with a hairline edge -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#171C25"
        android:endColor="#10141A" />
    <stroke
        android:width="1dp"
        android:color="#252C37" />
    <corners android:radius="28dp" />
</shape>

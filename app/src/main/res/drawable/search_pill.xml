<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen search bar: a softly lit pill -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#339B8CFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#20262F" android:endColor="#171C24" />
            <stroke android:width="1dp" android:color="#2E3644" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</ripple>
